{
  "$defs": {
    "discoflix.timeline.v1.Attachment.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(content_type)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "contentType": {
          "default": "",
          "type": "string"
        },
        "height": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "id": {
          "default": "",
          "type": "string"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "url": {
          "default": "",
          "type": "string"
        },
        "width": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        }
      },
      "title": "Attachment",
      "type": "object"
    },
    "discoflix.timeline.v1.Author.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(accent_color)$": {
          "default": "",
          "type": "string"
        },
        "^(avatar_url)$": {
          "default": "",
          "type": "string"
        },
        "^(display_name)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "accentColor": {
          "default": "",
          "type": "string"
        },
        "avatarUrl": {
          "default": "",
          "type": "string"
        },
        "displayName": {
          "default": "",
          "type": "string"
        },
        "id": {
          "default": "",
          "type": "string"
        },
        "kind": {
          "default": "",
          "description": "person, bot, plugin, agent",
          "type": "string"
        }
      },
      "title": "Author",
      "type": "object"
    },
    "discoflix.timeline.v1.EditMessageResponse.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "message": {
          "$ref": "#/$defs/discoflix.timeline.v1.Message.jsonschema.json"
        }
      },
      "title": "Edit Message Response",
      "type": "object"
    },
    "discoflix.timeline.v1.Message.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(channel_id)$": {
          "default": "",
          "type": "string"
        },
        "^(created_at)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json"
        },
        "^(deleted_at)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json"
        },
        "^(edited_at)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json"
        },
        "^(external_id)$": {
          "default": "",
          "type": "string"
        },
        "^(reply_to)$": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "^(space_id)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "attachments": {
          "items": {
            "$ref": "#/$defs/discoflix.timeline.v1.Attachment.jsonschema.json"
          },
          "type": "array"
        },
        "author": {
          "$ref": "#/$defs/discoflix.timeline.v1.Author.jsonschema.json"
        },
        "card": {
          "$ref": "#/$defs/google.protobuf.Any.jsonschema.json"
        },
        "channelId": {
          "default": "",
          "type": "string"
        },
        "content": {
          "default": "",
          "type": "string"
        },
        "createdAt": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json"
        },
        "deletedAt": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json"
        },
        "editedAt": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json"
        },
        "externalId": {
          "default": "",
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "pattern": "^MESSAGE_KIND_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "MESSAGE_KIND_USER",
                "MESSAGE_KIND_SYSTEM",
                "MESSAGE_KIND_CARD"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "title": "Message Kind"
        },
        "origin": {
          "default": "",
          "description": "Transport that wrote the message such as web, discord, system, api",
          "type": "string"
        },
        "reactions": {
          "items": {
            "$ref": "#/$defs/discoflix.timeline.v1.Reaction.jsonschema.json"
          },
          "type": "array"
        },
        "replyTo": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "seq": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "spaceId": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Message",
      "type": "object"
    },
    "discoflix.timeline.v1.Reaction.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "One emoji on a message with how many users added it",
      "properties": {
        "count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "emoji": {
          "default": "",
          "description": "Unicode emoji, or name:id for a custom Discord emoji",
          "type": "string"
        },
        "me": {
          "default": false,
          "description": "True when the caller is among the reactors",
          "type": "boolean"
        }
      },
      "title": "Reaction",
      "type": "object"
    },
    "google.protobuf.Any.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "title": "Any",
      "type": "object"
    },
    "google.protobuf.Timestamp.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    }
  },
  "$id": "discoflix.timeline.v1.EditMessageResponse.jsonschema.bundle.json",
  "$ref": "#/$defs/discoflix.timeline.v1.EditMessageResponse.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
