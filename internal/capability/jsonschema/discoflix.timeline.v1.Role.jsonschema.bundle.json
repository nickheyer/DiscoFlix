{
  "$defs": {
    "discoflix.timeline.v1.Role.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "color": {
          "default": "",
          "type": "string"
        },
        "hoist": {
          "default": false,
          "description": "Shown as its own group in the member list",
          "type": "boolean"
        },
        "id": {
          "default": "",
          "type": "string"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "position": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        }
      },
      "title": "Role",
      "type": "object"
    }
  },
  "$id": "discoflix.timeline.v1.Role.jsonschema.bundle.json",
  "$ref": "#/$defs/discoflix.timeline.v1.Role.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
