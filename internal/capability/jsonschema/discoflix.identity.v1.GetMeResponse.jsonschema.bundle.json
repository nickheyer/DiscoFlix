{
  "$defs": {
    "discoflix.identity.v1.GetMeResponse.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "identities": {
          "items": {
            "$ref": "#/$defs/discoflix.identity.v1.Identity.jsonschema.json"
          },
          "type": "array"
        },
        "memberships": {
          "items": {
            "$ref": "#/$defs/discoflix.identity.v1.Membership.jsonschema.json"
          },
          "type": "array"
        },
        "user": {
          "$ref": "#/$defs/discoflix.identity.v1.User.jsonschema.json"
        }
      },
      "title": "Get Me Response",
      "type": "object"
    },
    "discoflix.identity.v1.Identity.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(linked_at)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json"
        },
        "^(verified_at)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json"
        }
      },
      "properties": {
        "display": {
          "default": "",
          "type": "string"
        },
        "id": {
          "default": "",
          "type": "string"
        },
        "linkedAt": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json"
        },
        "provider": {
          "default": "",
          "description": "discord, plex, jellyfin, emby, oidc:\u003cissuer\u003e, local, email",
          "type": "string"
        },
        "subject": {
          "default": "",
          "type": "string"
        },
        "verifiedAt": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json"
        }
      },
      "title": "Identity",
      "type": "object"
    },
    "discoflix.identity.v1.Membership.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(space_id)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "roles": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "spaceId": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Membership",
      "type": "object"
    },
    "discoflix.identity.v1.User.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(accent_color)$": {
          "default": "",
          "type": "string"
        },
        "^(avatar_url)$": {
          "default": "",
          "type": "string"
        },
        "^(created_at)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json"
        },
        "^(display_name)$": {
          "default": "",
          "type": "string"
        },
        "^(last_seen_at)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json"
        },
        "^(system_admin)$": {
          "default": false,
          "type": "boolean"
        }
      },
      "properties": {
        "accentColor": {
          "default": "",
          "type": "string"
        },
        "avatarUrl": {
          "default": "",
          "type": "string"
        },
        "createdAt": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json"
        },
        "displayName": {
          "default": "",
          "type": "string"
        },
        "id": {
          "default": "",
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "pattern": "^USER_KIND_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "USER_KIND_PERSON",
                "USER_KIND_BOT",
                "USER_KIND_PLUGIN",
                "USER_KIND_AGENT"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "title": "User Kind"
        },
        "lastSeenAt": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json"
        },
        "status": {
          "anyOf": [
            {
              "pattern": "^USER_STATUS_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "USER_STATUS_ACTIVE",
                "USER_STATUS_DISABLED"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "title": "User Status"
        },
        "systemAdmin": {
          "default": false,
          "type": "boolean"
        }
      },
      "title": "User",
      "type": "object"
    },
    "google.protobuf.Timestamp.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    }
  },
  "$id": "discoflix.identity.v1.GetMeResponse.jsonschema.bundle.json",
  "$ref": "#/$defs/discoflix.identity.v1.GetMeResponse.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
