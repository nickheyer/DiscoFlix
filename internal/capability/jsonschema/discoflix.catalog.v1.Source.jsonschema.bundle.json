{
  "$defs": {
    "discoflix.catalog.v1.Source.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(calls_today)$": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "^(has_client_key)$": {
          "default": false,
          "type": "boolean"
        },
        "^(key_hint)$": {
          "default": "",
          "description": "Where the administrator obtains the key",
          "type": "string"
        },
        "^(last_error)$": {
          "default": "",
          "type": "string"
        },
        "^(last_error_at)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json"
        },
        "^(last_ok_at)$": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json"
        },
        "^(needs_key)$": {
          "default": false,
          "type": "boolean"
        }
      },
      "properties": {
        "artwork": {
          "default": false,
          "description": "The source offers posters, backdrops, or logos",
          "type": "boolean"
        },
        "budget": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "callsToday": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "configured": {
          "default": false,
          "description": "A key is stored, or none is needed",
          "type": "boolean"
        },
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "hasClientKey": {
          "default": false,
          "type": "boolean"
        },
        "keyHint": {
          "default": "",
          "description": "Where the administrator obtains the key",
          "type": "string"
        },
        "lastError": {
          "default": "",
          "type": "string"
        },
        "lastErrorAt": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json"
        },
        "lastOkAt": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.json"
        },
        "license": {
          "default": "",
          "type": "string"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "namespaces": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "needsKey": {
          "default": false,
          "type": "boolean"
        },
        "options": {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "state": {
          "default": "",
          "description": "ok, failing, open, disabled, unconfigured, idle",
          "type": "string"
        },
        "title": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Source",
      "type": "object"
    },
    "google.protobuf.Timestamp.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    }
  },
  "$id": "discoflix.catalog.v1.Source.jsonschema.bundle.json",
  "$ref": "#/$defs/discoflix.catalog.v1.Source.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
