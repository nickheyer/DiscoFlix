        "spaceId": {
          "default": "",
          "type": "string"
        },
        "topic": {
          "default": "",
          "type": "string"
        },
        "unread": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        }
      },
      "title": "Channel",
      "type": "object"
    }
  },
  "$id": "discoflix.timeline.v1.Channel.jsonschema.bundle.json",
  "$ref": "#/$defs/discoflix.timeline.v1.Channel.jsonschema.json",
