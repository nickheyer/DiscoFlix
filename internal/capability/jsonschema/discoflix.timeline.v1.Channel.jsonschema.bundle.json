{
  "$defs": {
    "discoflix.timeline.v1.Channel.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(external_id)$": {
          "default": "",
          "type": "string"
        },
        "^(last_read_seq)$": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "^(last_seq)$": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "^(max_content)$": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "Longest message content this channel accepts, lower on channels mirrored to Discord"
        },
        "^(parent_id)$": {
          "default": "",
          "type": "string"
        },
        "^(space_id)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "externalId": {
          "default": "",
          "type": "string"
        },
        "id": {
          "default": "",
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "pattern": "^CHANNEL_KIND_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "CHANNEL_KIND_TEXT",
                "CHANNEL_KIND_CATEGORY",
                "CHANNEL_KIND_VOICE",
                "CHANNEL_KIND_THREAD"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "title": "Channel Kind"
        },
        "lastReadSeq": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "lastSeq": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "maxContent": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "Longest message content this channel accepts, lower on channels mirrored to Discord"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "parentId": {
          "default": "",
          "type": "string"
        },
        "position": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
