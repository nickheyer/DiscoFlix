      "additionalProperties": false,
      "patternProperties": {
        "^(after_seq)$": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "Resume after this seq, 0 means from now"
        },
        "^(space_id)$": {
          "default": "",
          "description": "Restrict to one space, empty means every space the caller can read",
          "type": "string"
        }
      },
      "properties": {
