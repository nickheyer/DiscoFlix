      "patternProperties": {
        "^(user_id)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "count": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0,
          "description": "Reactors with this emoji after the change"
        },
        "emoji": {
          "default": "",
          "type": "string"
        },
        "seq": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "userId": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Reaction Change",
      "type": "object"
    }
  },
  "$id": "discoflix.timeline.v1.ReactionChange.jsonschema.bundle.json",
  "$ref": "#/$defs/discoflix.timeline.v1.ReactionChange.jsonschema.json",
