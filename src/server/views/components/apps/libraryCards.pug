//- LIBRARY PAGE FRAGMENT - COVER CARDS OR DETAILED ROWS PER THE ACTIVE VIEW,
//- PLUS THE VIEW MORE SENTINEL; INCLUDED BY THE LIBRARY SECTION AND RETURNED
//- BARE BY GET /apps/:id/library/page/:n. LOCALS: activeApp, library,
//- contentKind, view
include ../../mixins/browse
- var libraryItems = (library && library.items) || []
- var libraryPage = (library && library.page) || 1
- var libraryView = typeof view === 'string' ? view : 'covers'

each item in libraryItems
  if libraryView === 'detailed'
    +libraryBrowseRow(item, activeApp.id, contentKind)
  else
    +browsePosterCard({ clickUrl: `/apps/${activeApp.id}/library/item/${item.id}`, title: item.title, year: item.year, posterUrl: item.posterUrl, badge: item.available ? 'available' : null, kind: contentKind })
if library && library.hasMore
  button.appLoadMore.libraryLoadMore(
    type="button"
    hx-get=`/apps/${activeApp.id}/library/page/${libraryPage + 1}`
    hx-swap="outerHTML"
    hx-disabled-elt="this"
  )
    span View More
    svg.appSpinner(viewBox="0 0 24 24" aria-hidden="true")
      circle(cx="12" cy="12" r="10")
