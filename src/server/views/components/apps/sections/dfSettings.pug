//- DISCOFLIX SETTINGS - THE Configuration SINGLETON IN THE TAKEOVER SURFACE.
//- ONE .appSettingsGroup ROW PER CONFIG_FIELD_GROUPS ENTRY (TITLE+BLURB RAIL
//- | FIELD CARD); SAVES AUTO-FIRE ON CHANGE AND THE TOAST RIDES THE TAKEOVER
//- HEADER, SAME AS EVERY APP FORM.
//- sectionData: { formGroups [{label, blurb, fields [+field DESCRIPTORS + key]}] }
include ../../../mixins/field

include ../sectionTitleDivider

form.appSettingsForm(
  hx-post=`/apps/${activeApp.id}/save`
  hx-trigger="change, submit"
  hx-swap="none"
)
  each group in sectionData.formGroups
    .appSettingsGroup
      .appSettingsGroupInfo
        .request-section-header= group.label
        if group.blurb
          .appSettingsGroupBlurb= group.blurb
      .appSettingsGroupBody
        .appFormCard
          .appSettingsFields
            each f in group.fields
              +field(f, f.key, activeApp.id, false)
          //- UNSECURED-DB WARNING - SAME GATE AS THE HOME BADGE'S "!" BUBBLE
          //- (ENABLED + NO CONSOLE PASSWORD + NOT DISMISSED). DISMISS IS
          //- STICKY AND CLEARS THE BUBBLE EVERYWHERE.
          if group.warning
            .dfDbWarnCard
              .dfDbWarnText
                strong Heads up:
                |  the database admin is enabled but this console has no password. Anyone who can reach this page can read and edit the entire database. Set an admin password above, or dismiss this if the console never leaves your network.
              button.modal-button.button-secondary(
                type="button"
                hx-post="/discoflix/db-warning/dismiss"
                hx-target="closest .dfDbWarnCard"
                hx-swap="outerHTML"
              ) Dismiss
