//- USERS BODY - AUDIENCE TABS + THE CARD LIST, SWAPPED WHOLE ON EVERY
//- SEARCH/FILTER CHANGE SO TABS AND COUNTS ALWAYS AGREE. PEOPLE (THE END
//- USERS THE BOT SERVES) ARE THE DEFAULT LENS; OPEN ACCESS ASKS GET THEIR
//- OWN TAB WHILE WHITELIST MODE IS ON. LOCALS: activeApp, users, mutableFields
- var filterTabs = [{ key: 'people', label: 'People' }, { key: 'bots', label: 'Bots' }]
- if (users.counts.access) filterTabs.push({ key: 'access', label: 'Wants access' })
- filterTabs.push({ key: 'all', label: 'All' })

//- THE ACTIVE FILTER RIDES SEARCH REQUESTS VIA hx-include
input#dfUserFilter(type="hidden" name="filter" value=users.filter)

.request-section-header.appLibraryHeader
  if users.search
    span Users - #{users.counts[users.filter]} for “#{users.search}”
  else
    span Users - #{users.counts[users.filter]}
  .appLibraryHeaderTools
    .appInstanceTabs.appLibKindTabs
      each tab in filterTabs
        .appInstanceTab(
          role="button"
          tabindex=users.filter !== tab.key ? "0" : undefined
          class=`${users.filter === tab.key ? 'active' : ''}${tab.key === 'access' ? ' dfWantsTab' : ''}`
          hx-get=users.filter !== tab.key ? `/apps/${activeApp.id}/users?filter=${tab.key}` : undefined
          hx-include=users.filter !== tab.key ? '.appSearchInput' : undefined
          hx-target=users.filter !== tab.key ? '#dfUsersBody' : undefined
          hx-swap=users.filter !== tab.key ? 'innerHTML' : undefined
          hx-trigger=users.filter !== tab.key ? "click, keyup[key=='Enter']" : undefined
        ) #{tab.label} (#{users.counts[tab.key]})

#dfUserList
  include dfUserCards
