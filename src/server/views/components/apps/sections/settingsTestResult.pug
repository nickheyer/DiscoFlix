//- INLINE RESULT PILL FOR THE SETTINGS "TEST CONNECTION" BUTTON. NO SELF-OOB -
//- THIS IS THE MAIN SWAP CONTENT (hx-target="#appTestResult"); THE RAIL RIDES
//- ALONG OOB IN THE SAME RESPONSE. status: { ok, version|error }
span#appTestResult
  if status
    span.appStatusPill(class=status.ok ? 'ok' : 'down')= status.ok ? (status.version ? `Connected - v${status.version}` : 'Connected') : (status.error || 'unreachable')
