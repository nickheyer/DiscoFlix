//- USER CARDS + VIEW MORE - INCLUDED BY dfUsers AND RETURNED BARE BY
//- GET /apps/:id/users (SEARCH AND PAGINATION SHARE THIS FRAGMENT)
include dfUserCard

- var userRows = (users && users.rows) || []
- var currentUsersPage = (users && users.page) || 1

if !userRows.length
  .appQueueEmpty= users && users.search ? `No users matching "${users.search}"` : 'No users tracked yet - they appear as people chat in your servers.'
else
  each u in userRows
    +dfUserCard(u)
  if users.hasMore
    button.appLoadMore.dfUsersMore(
      type="button"
      hx-get=`/apps/${activeApp.id}/users?page=${currentUsersPage + 1}&search=${encodeURIComponent(users.search || '')}`
      hx-swap="outerHTML"
      hx-disabled-elt="this"
    )
      span View More
      svg.appSpinner(viewBox="0 0 24 24" aria-hidden="true")
        circle(cx="12" cy="12" r="10")
