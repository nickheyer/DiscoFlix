//- DISCOFLIX OVERVIEW - THE BOT'S OWN HEALTH PANEL, DRESSED LIKE EVERY OTHER
//- APP'S ABOUT-THIS-APP PAGE: CENTERED IDENTITY, PROBLEMS, OPS STATS, AND
//- EVERY CONNECTED APP AT A GLANCE.
//- sectionData: { bot, problems [{type,message}], stats, apps [rows] }
include ../../../mixins/overview
- var bot = sectionData.bot

.appSectionDoc
  +aboutApp({ icon: bot.avatar || '/images/favicon.png', round: true, name: bot.username, nameSuffix: `#${bot.discriminator}`, pill: { text: bot.online ? 'online' : 'offline', class: bot.online ? 'ok' : 'down' }, sub: bot.enabled ? 'The bot is powered on' : 'The bot is powered off', sub2: `DiscoFlix v${bot.version}` })

  +overviewNotices(sectionData.problems)

  .request-section-header At a Glance
  .appStatsGrid
    +statTile(sectionData.stats.servers, `Server${sectionData.stats.servers === 1 ? '' : 's'}`)
    +statTile(sectionData.stats.users, `User${sectionData.stats.users === 1 ? '' : 's'}`)
    +statTile(sectionData.stats.requests, `Request${sectionData.stats.requests === 1 ? '' : 's'}`)
    +statTile(sectionData.stats.pending, 'Pending', !!sectionData.stats.pending)
    +statTile(sectionData.stats.queueCount, 'Downloading')

  .request-section-header Connected Apps
  if !sectionData.apps.length
    .appQueueEmpty No apps connected yet - add Radarr, Sonarr, and friends with the green + on the rail.
  else
    .dfAppList
      each app in sectionData.apps
        //- ROW CLICK ENTERS THAT APP'S TAKEOVER
        .dfAppRow(
          role="button"
          tabindex="0"
          aria-label=`Open ${app.label}`
          hx-post=`/change-active-app/${app.id}`
          hx-trigger="click, keyup[key=='Enter']"
        )
          img.dfAppIcon(src=app.icon alt=app.label)
          .dfAppName= app.label
          span.appStatusPill(class=app.statusClass)= app.statusText

  .appSectionActions
    button.modal-button.button-secondary(
      hx-get="/modal/requests/dashboard"
      hx-target="#modals-here"
      hx-trigger="click"
      data-bs-toggle="modal"
      data-bs-target="#modals-here"
    ) Media Requests
    if bot.inviteLink
      button.modal-button.button-secondary(
        hx-get="/modal/bot/invite"
        hx-target="#modals-here"
        hx-trigger="click"
        data-bs-toggle="modal"
        data-bs-target="#modals-here"
      ) Invite Bot
    button.modal-button.button-secondary(
      hx-post=`/apps/${activeApp.id}/section/overview`
    ) Refresh
