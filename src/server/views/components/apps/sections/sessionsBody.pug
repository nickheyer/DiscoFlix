//- NOW PLAYING ROWS - LOCALS: activeApp, sessions (NORMALIZED SESSION ROWS).
//- WHOLE-LIST OOB SWAP LIKE THE QUEUE; ROW IDS STAY STABLE SO THE 0.5s WIDTH
//- TRANSITION KEEPS PLAYBACK BARS SMOOTH BETWEEN PUSHES.
#appSessionList(
  hx-select-oob="#appSessionList"
  hx-swap-oob="outerHTML"
)
  - var rows = sessions || []
  if rows.length
    each item in rows
      - var paused = item.state === 'paused'
      .request-row.queueRow.sessionRow(id=`apps-${activeApp.id}-${item.id}`)
        .sessionStateGlyph(class=paused ? 'paused' : '')
          if paused
            svg(viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true")
              path(d="M9 5v14M15 5v14")
          else
            svg(viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true")
              path(d="M8 5.5v13l11-6.5z")
        .request-info
          .request-title.queueRowTitle
            span= item.title
            if item.subtitle
              span.sessionSubtitle= item.subtitle
          if item.chips && item.chips.length
            .queueRowChips
              each chip in item.chips
                span.queueRowChip= chip
          .request-meta
            span= item.user
            if item.device
              span.request-meta-divider •
              span= item.device
            span.request-meta-divider •
            span= item.state
        .request-status
          .request-progress
            .request-progress-track
              .request-progress-bar(class=paused ? 'paused' : undefined style=`width: ${item.percent}%`)
            .request-progress-text #{item.percent}% watched
  else
    .appQueueEmpty Nobody is streaming right now.
