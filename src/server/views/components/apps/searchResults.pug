//- RESULT LIST FOR #appSearchResults; searchResults null = PROMPT STATE, [] = NO MATCHES.
include ../../mixins/appSearchRow
if searchError
  .appQueueEmpty Search failed - #{searchError}
else if !searchResults
  .appQueueEmpty Search for something to add to #{activeApp.display_name}.
else if !searchResults.length
  .appQueueEmpty No results for “#{searchTerm}”.
else
  each result in searchResults
    +appSearchRow(result, activeApp.id)
