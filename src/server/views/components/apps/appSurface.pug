//- TAKEOVER CONTENT SURFACE - REUSES #messageContainer SO EVERY EXISTING SWAP
//- PATH RESTORES THE MIRROR WHOLESALE ON BACK-OUT. .appSurface FLIPS THE FLEX
//- DIRECTION (CHAT IS column-reverse) AND ADDS PADDING.
.messageContainer.appSurface#messageContainer(
  hx-select-oob="#messageContainer"
  hx-swap-oob="outerHTML"
)
  .appSectionBody#appSectionBody
    //- THE DISCOFLIX SELF APP CARRIES ITS OWN OVERVIEW/USERS/SETTINGS BODIES
    case section
      when 'queue'
        include sections/queue
      when 'sessions'
        include sections/sessions
      //- THE UNIFIED REQUEST PIPELINE - DISCOFLIX ONLY (THE MANIFEST IS THE GUARD)
      when 'requests'
        include sections/dfRequests
      //- THE FEATURE MATRIX - DISCOFLIX ONLY (THE MANIFEST IS THE GUARD)
      when 'bot'
        include sections/dfBot
      //- EVERY LIBRARY IS THE ONE UNIFIED COMPONENT (SCOPED PER INSTANCE);
      //- ONLY LIVE SEARCH RESULTS KEEP THEIR OWN SURFACE
      when 'library'
        if sectionData.mode === 'search'
          include sections/library
        else
          include sections/dfLibrary
      when 'releases'
        include sections/releases
      when 'users'
        include sections/dfUsers
      when 'logs'
        include sections/dfLogs
      when 'settings'
        if activeApp.app_type === 'discoflix'
          include sections/dfSettings
        else
          include sections/settings
      default
        if activeApp.app_type === 'discoflix'
          include sections/dfOverview
        else
          include sections/overview
