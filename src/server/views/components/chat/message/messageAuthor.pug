//- DISCORD ONLY TAGS BOTS — HUMANS GET NO CHIP. WHITE-DEFAULT USERNAMES SKIP
//- THE INLINE STYLE ENTIRELY SO THE CSS COLOR CAN CASCADE.
- var showColor = authorColor && authorColor.toLowerCase() !== '#ffffff'
.chatAuthor
  b.chatAuthorUsername(style=showColor ? `color: ${authorColor}` : undefined)
    if (username)
      if (username.length > 24)
        = username.substr(0, 24) + '...'
      else
        = username
    else
      | Unavailable
  if isBot
    .chatMessageTag BOT
  .chatMessageDate #{timeStamp || ""}
