//- DISCORD'S "+" ATTACHES FILES; OURS OPENS THE REQUEST DASHBOARD - THE ONE
//- SURFACE THAT MATTERS. SAME MODAL WIRING AS THE CHANNEL GEAR / INVITE BUTTON.
.plusButton(
  aria-label="Media Requests"
  data-tooltip-dir="top"
  role="button"
  tabindex="0"
  hx-get="/modal/requests/dashboard"
  hx-target="#modals-here"
  hx-trigger="click, keyup[key=='Enter']"
  data-bs-toggle="modal"
  data-bs-target="#modals-here"
)
  svg(
    xmlns="http://www.w3.org/2000/svg",
    width="24", height="24", viewBox="0 0 24 24",
    fill="none", stroke="currentColor", stroke-width="2",
    stroke-linecap="round", stroke-linejoin="round"
  )
    line(x1="12", y1="5", x2="12", y2="19")
    line(x1="5", y1="12", x2="19", y2="12")