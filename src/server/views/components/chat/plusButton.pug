//- OG-DISCORD ATTACH - THE + STAGES A FILE FOR THE ACTIVE CHANNEL (SENT AS
//- THE BOT); THE CHAT INPUT'S ENTER SHIPS IT THROUGH POST /chat/upload.
//- NO ACTIVE CHANNEL = NO PICKER (SAME HONESTY AS THE DISABLED INPUT).
if servers.activeChannel && servers.activeChannel.channel_name
  label.plusButton(
    for="chatUploadFile"
    aria-label="Attach a file"
    data-tooltip-dir="top"
    role="button"
    tabindex="0"
  )
    svg(
      xmlns="http://www.w3.org/2000/svg",
      width="24", height="24", viewBox="0 0 24 24",
      fill="none", stroke="currentColor", stroke-width="2",
      stroke-linecap="round", stroke-linejoin="round"
    )
      line(x1="12", y1="5", x2="12", y2="19")
      line(x1="5", y1="12", x2="19", y2="12")
else
  .plusButton.disabled(aria-hidden="true")
    svg(
      xmlns="http://www.w3.org/2000/svg",
      width="24", height="24", viewBox="0 0 24 24",
      fill="none", stroke="currentColor", stroke-width="2",
      stroke-linecap="round", stroke-linejoin="round"
    )
      line(x1="12", y1="5", x2="12", y2="19")
      line(x1="5", y1="12", x2="19", y2="12")
