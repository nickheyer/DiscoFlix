//- FIRST-RUN CHECKLIST - REPLACES THE EMPTY-MIRROR WELCOME UNTIL THE BOT HAS A TOKEN AND A SERVER.
- var onboardingSteps = (onboarding && onboarding.steps) || []
- var ctaShown = false
.gettingStarted
  button.gettingStartedDismiss(
    type="button"
    aria-label="Dismiss this checklist"
    title="Dismiss this checklist"
    hx-post="/onboarding/dismiss"
    hx-swap="none"
    hx-trigger="click"
  )
    svg(viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true")
      path(stroke-linecap="round" stroke-width="2" d="M6 6l12 12M18 6L6 18")
  .welcomeBlock
    .welcomeHashCircle
      svg(viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true")
        path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 3L4 14h6l-1 7 9-11h-6l1-7z")
    .welcomeTitle Welcome to DiscoFlix!
    .welcomeSubtitle Your bot isn't fully set up yet - run through this checklist and it'll be serving requests in minutes.
  each step in onboardingSteps
    - var isNext = !step.done && !ctaShown
    - if (isNext) ctaShown = true
    .gettingStartedStep(class=step.done ? 'done' : undefined)
      .gettingStartedCheck(class=step.done ? 'done' : undefined)
        svg(viewBox="0 0 24 24" aria-hidden="true")
          circle.gettingStartedRing(cx="12" cy="12" r="10")
          if step.done
            path.gettingStartedTick(d="M8 12.5l3 3 5.5-6.5")
      .gettingStartedInfo
        .gettingStartedLabel= step.label
        if step.hint && !step.done
          .gettingStartedHint= step.hint
      if step.cta && isNext
        if step.cta.post
          //- TAKEOVER CTAs SWAP THE WHOLE CONSOLE, MODAL CTAs POP A DIALOG
          button.modal-button.gettingStartedCta(
            hx-post=step.cta.post
            hx-trigger="click"
            hx-select-oob="#guildNameBanner"
          )= step.cta.label
        else
          button.modal-button.gettingStartedCta(
            hx-get=step.cta.url
            hx-target="#modals-here"
            hx-trigger="click"
            data-bs-toggle="modal"
            data-bs-target="#modals-here"
          )= step.cta.label
