//- PSEUDO-GUILDS FOR THE CONNECTED APPS (nzb360-STYLE) — RENDERED BELOW THE
//- REAL GUILDS BEHIND THEIR OWN DIVIDER. `apps` COMES FROM renderHome; THE
//- RAIL IS STATIC PER PAGE LOAD (WS RE-RENDERS ONLY TOUCH THE SORTABLE FORM).
if apps && apps.length
  hr.serverDivider
  .appRail#appRail
    each app in apps
      .server.appBubble(
        aria-label=app.label
        data-cooltipz-dir="right"
        hx-get=`/modal/apps/${app.id}`
        hx-target="#modals-here"
        hx-trigger="click"
        data-bs-toggle="modal"
        data-bs-target="#modals-here"
      )
        if app.configured && app.enabled
          .statusBubble.online
        else if app.configured
          .statusBubble.offline
        img.appIcon(src=app.icon alt=app.label)
