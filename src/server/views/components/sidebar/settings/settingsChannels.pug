include settingsChannelsHeader

.settingsChannelContainer
  -
    var settingsChannels = [
      { name: 'Requests', url: '/modal/requests/dashboard' },
      { name: 'Configuration', type: 'configuration' },
      { name: 'Users', type: 'user' }
    ];

  each channel in settingsChannels
    .channelViewOption(
      hx-get=channel.url || `/modal/settings/${channel.type}`
      hx-target="#modals-here"
      hx-trigger="click"
      data-bs-toggle="modal"
      data-bs-target="#modals-here"
    )
      .channelViewOptionInfo
        include settingsChannelHashIcon
        span= channel.name

include infoChannelsHeader

.settingsChannelContainer
  -
    var infoChannels = [
      { name: 'Application State', type: 'state' },
      { name: 'Discord Bot', type: 'discordBot' },
      { name: 'Discord Servers', type: 'discordServer' },
      { name: 'Discord Channels', type: 'discordChannel' },
    ];

  each channel in infoChannels
    .channelViewOption(
      hx-get=`/modal/settings/${channel.type}`
      hx-target="#modals-here"
      hx-trigger="click"
      data-bs-toggle="modal"
      data-bs-target="#modals-here"
    )
      .channelViewOptionInfo
        include settingsChannelHashIcon
        span= channel.name
