//- CACHED AVATARS ARE STORED AS BARE PATHS (discord_bot_images/…) - SERVE ROOT-RELATIVE
- var botAvatar = discordBot.bot_avatar_url
- var botAvatarSrc = botAvatar ? (/^https?:\/\//.test(botAvatar) ? botAvatar : `/${botAvatar.replace(/^\/+/, '')}`) : "https://cdn.discordapp.com/embed/avatars/0.png"
div.currentUserImage
  div.userAvatarBubble
    div.statusBubble(class=(discordBot.bot_username ? (state.discord_state ? 'online' : 'offline') : ''))
    img.userAvatar(
      src=botAvatarSrc
      alt="avatar"
      referrerpolicy="no-referrer"
    )