include ../../../mixins/notification
include ../../../mixins/requestRow

- var pending = requests.filter(r => r.state === 'pending')
- var active = requests.filter(r => r.state === 'approved' || r.state === 'downloading')
- var history = requests.filter(r => r.state === 'available' || r.state === 'denied')

.modal-dialog.modal-dialog-centered.modal-dialog-scrollable.modal-lg
  .modal-content
    .modal-header
      h5.modal-title Media Requests
      button.modal-close-button(type='button' data-bs-dismiss='modal' aria-label='Close') ×

    .modal-body
      #requests-container.requests-container
        if !requests.length
          .empty-state
            .empty-state-text No requests yet — ask for something in Discord!
        else
          if pending.length
            .request-section-header Pending Approval
            each req in pending
              +requestRow(req, false, instanceOptions)
          if active.length
            .request-section-header Active
            each req in active
              +requestRow(req, false, instanceOptions)
          if history.length
            .request-section-header History
            each req in history
              +requestRow(req, false, instanceOptions)

    //- REFRESH IS A REAL ACTION (WS PUSHES COVER MOST UPDATES, BUT MANUAL
    //- RE-SYNC IS USEFUL); CLOSE IS REDUNDANT WITH X/BACKDROP/ESC
    .modal-footer
      +Notification
      button.modal-button.button-secondary(
        hx-get='/modal/requests/dashboard'
        hx-target='#modals-here'
        hx-swap='innerHTML'
      ) Refresh
