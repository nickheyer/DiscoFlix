//- "ADD AN APP" PICKER - ONE CARD PER MANIFEST TYPE. TYPES STAY ADDABLE
//- FOREVER (MULTI-INSTANCE); THE BADGE JUST SAYS HOW MANY YOU ALREADY RUN.
//- CARD RESPONSE = THE FULL TAKEOVER FRAGMENT SET LANDING ON THE NEW
//- INSTANCE'S SETTINGS, SO THE MODAL DISMISSES AND THE CONSOLE SWAPS UNDER IT.
//- THE (i) TOGGLE EXPANDS THE CARD INTO ITS FUNCTION LIST + WHY-ADD-IT LINE
//- WITHOUT TRIGGERING THE ADD (halt STOPS THE CARD'S CLICK AND THE DISMISS).
.modal-dialog.modal-dialog-centered#modal-container(hx-target="#modals-here")
  .modal-content
    .modal-header
      h5.modal-title Add an App
      button.modal-close-button(type="button" data-bs-dismiss="modal") ×
    .modal-body
      -
        var KIND_META = {
          'content-manager': { label: 'Content Manager', cls: '' },
          'download-client': { label: 'Download Client', cls: 'download' },
          'media-server':    { label: 'Media Server', cls: 'media' },
          'indexer':         { label: 'Indexer', cls: 'indexer' }
        };
      .appPickerGrid
        each t in appTypes
          - var kindMeta = KIND_META[t.kind] || { label: t.kind, cls: '' }
          .appPickerCard(
            role="button"
            aria-label=`Add ${t.label}`
            hx-post=`/apps/add/${t.id}`
            hx-swap="none"
            hx-select-oob="#serverSelector,#guildNameBanner"
            data-bs-dismiss="modal"
          )
            img(src=t.icon alt="")
            .appPickerInfo
              .appPickerName
                span= t.label
                span.appPickerKind(class=kindMeta.cls)= kindMeta.label
              .appPickerBlurb= t.blurb
              if t.installed
                .appPickerInstalled= `${t.installed} installed`
            if t.functions.length
              button.appPickerInfoToggle(
                type="button"
                aria-label=`What you get with ${t.label}`
                data-tooltip-dir="left"
                _="on click halt the event then toggle .expanded on the closest .appPickerCard"
              )
                svg(viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true")
                  circle(cx="12" cy="12" r="9")
                  path(d="M12 11v5M12 8h.01")
            if t.functions.length
              .appPickerDetail(_="on click halt the event")
                ul.appPickerFunctions
                  each fn in t.functions
                    li
                      svg(viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true")
                        path(d="M5 13l4 4L19 7")
                      span= fn
                if t.why
                  .appPickerWhy= t.why
