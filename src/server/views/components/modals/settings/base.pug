include ../../../mixins/search

//- READ-ONLY INFO POPUP - NO FOOTER, NO FORMS: X / BACKDROP / ESC ALL CLOSE
.modal-dialog.modal-dialog-centered.modal-dialog-scrollable.modal-lg
