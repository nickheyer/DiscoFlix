//- ABOUT-THIS-APP OVERVIEW PIECES - SHARED BY overview.pug (EVERY SERVICE)
//- AND dfOverview.pug (THE SELF APP) SO ALL OVERVIEWS READ AS ONE DESIGN.

//- about: { icon, round?, name, nameSuffix?, pill {text, class}, sub?, sub2?, url? }
mixin aboutApp(about)
  .appAboutBlock
    img.appAboutIcon(class=about.round ? 'round' : undefined src=about.icon alt=about.name referrerpolicy="no-referrer")
    .appAboutName
      | #{about.name}
      if about.nameSuffix
        span.dfDiscriminator= about.nameSuffix
      |
      span.appStatusPill(class=about.pill.class)= about.pill.text
    if about.sub
      .appAboutSub= about.sub
    if about.sub2
      .appAboutSub= about.sub2
    if about.url
      a.appOverviewUrl(href=about.url target="_blank" rel="noopener noreferrer")= about.url

//- null/undefined VALUES RENDER AS A DASH - COLD CACHES, NOT ERRORS
mixin statTile(value, label, attention)
  .appStat(class=attention ? 'attention' : undefined)
    .appStatValue= (value === null || value === undefined) ? '-' : value
    .appStatLabel= label

mixin overviewNotices(notices)
  if notices && notices.length
    .request-section-header Needs Attention
    each item in notices
      .appHealthNotice(class=item.type === 'error' ? 'error' : '')= item.message
  else
    .appHealthNotice.good All systems go - nothing needs attention.
