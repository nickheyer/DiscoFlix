{
	"name": "discoflix-web",
	"version": "4.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pwa-assets-generator && vite dev",
		"build": "pwa-assets-generator && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"test": "vitest run",
		"icons": "pwa-assets-generator"
	},
	"devDependencies": {
		"@bufbuild/protobuf": "2.17.0",
		"@connectrpc/connect": "2.3.0",
		"@connectrpc/connect-query-core": "2.3.1",
		"@connectrpc/connect-web": "2.3.0",
		"@fontsource-variable/noto-sans": "5.3.0",
		"@internationalized/date": "3.12.4",
		"@lucide/svelte": "1.70.0",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.5",
		"@tanstack/svelte-query": "6.4.1",
		"@tanstack/svelte-virtual": "3.13.52",
		"@unplugin-pwa/core": "0.0.4",
		"@vite-pwa/assets-generator": "2.0.0",
		"@vite-pwa/sveltekit": "2.0.1",
		"bits-ui": "2.20.6",
		"centrifuge": "5.8.0",
		"cn": "0.5.2",
		"magicast": "0.5.5",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"shadcn-svelte": "1.8.0",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"tailwind-variants": "3.3.1",
		"tailwindcss": "4.3.5",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"virtua": "0.54.2",
		"vite": "8.3.6",
		"vitest": "5.1.0"
	},
	"imports": {
		"#lib/*": {
			"types": [
				"./src/lib/*.ts",
				"./src/lib/*/index.ts",
				"./src/lib/*"
			],
			"default": "./src/lib/*"
		}
	}
}
