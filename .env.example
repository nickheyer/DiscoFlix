# DISCOFLIX ENV SETTINGS SEED - COPY TO .env AND FILL IN WHAT YOU RUN.
# EVERY VAR IS OPTIONAL. VALUES FILL EMPTY SETTINGS AT BOOT (FIRST-RUN
# FRIENDLY) AND NEVER OVERWRITE ANYTHING SAVED THROUGH THE UI.
# APP VARS ADDRESS ONE INSTANCE PER TYPE - EXTRA INSTANCES ARE UI-ONLY.

PORT=5001

# DISCORD BOT TOKEN (DEVELOPER PORTAL -> BOT -> TOKEN)
DISCORD_TOKEN=

# CONTENT MANAGERS (API KEY: SETTINGS -> GENERAL)
RADARR_URL=
RADARR_API_KEY=

SONARR_URL=
SONARR_API_KEY=

# DOWNLOAD CLIENTS
SABNZBD_URL=
SABNZBD_API_KEY=

QBITTORRENT_URL=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=

NZBGET_URL=
NZBGET_USERNAME=
NZBGET_PASSWORD=

DELUGE_URL=
DELUGE_PASSWORD=

TRANSMISSION_URL=
TRANSMISSION_USERNAME=
TRANSMISSION_PASSWORD=

RUTORRENT_URL=
RUTORRENT_USERNAME=
RUTORRENT_PASSWORD=

UTORRENT_URL=
UTORRENT_USERNAME=
UTORRENT_PASSWORD=

# MEDIA SERVERS
PLEX_URL=
PLEX_API_KEY=

EMBY_URL=
EMBY_API_KEY=

JELLYFIN_URL=
JELLYFIN_API_KEY=

# INDEXERS
JACKETT_URL=
JACKETT_API_KEY=

NZBHYDRA2_URL=
NZBHYDRA2_API_KEY=

# SET TO 1 ONLY TO RECOVER FROM AN ADMIN-PASSWORD LOCKOUT
# DF_DISABLE_AUTH=

# SET TO 1 TO REQUEST THE PRIVILEGED PRESENCE INTENT (MEMBERS-PANE STATUS
# DOTS). REQUIRES THE "PRESENCE INTENT" TOGGLE IN THE DISCORD DEV PORTAL -
# WITHOUT IT THE BOT LOGIN FAILS
# DF_PRESENCE_INTENT=
